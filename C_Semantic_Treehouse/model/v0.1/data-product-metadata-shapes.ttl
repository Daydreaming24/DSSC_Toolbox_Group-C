@prefix be: <https://w3id.org/dssc-demo/building-energy#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

be:DataProductMetadataShape-v0_1
    a sh:NodeShape ;
    sh:targetClass be:DataProductMetadata ;
    sh:property [
        sh:path dct:identifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "datasetId is required and must be a single string." ;
    ] ;
    sh:property [
        sh:path be:providerName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "providerName is required in v0.1." ;
    ] ;
    sh:property [
        sh:path be:format ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "format is required in v0.1." ;
    ] ;
    sh:property [
        sh:path be:frequency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "frequency is required in v0.1." ;
    ] ;
    sh:property [
        sh:path be:spatialCoverage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "spatialCoverage is required in v0.1." ;
    ] .
