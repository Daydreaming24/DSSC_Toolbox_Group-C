        {
          "id": "v0.4.manifest-semantics",
          "entrypoint": "check_v04_manifest_semantics"
        },
        {
          "id": "v0.4.fixture-hashes",
          "entrypoint": "check_v04_fixture_hashes"
        },
        {
          "id": "v0.4.four-state",
          "entrypoint": "check_v04_four_state"
        },
        {
          "id": "v0.4.report-assertions",
          "entrypoint": "check_v04_report_assertions"
        },
        {
          "id": "v0.4.target-activation",
          "entrypoint": "check_v04_target_activation"
        },
        {
          "id": "v0.4.fault-injection",
          "entrypoint": "check_v04_fault_injection"
        }
