{
  "$schema": "schemas/validation-suites.schema.json",
  "contract_version": "1.6.0",
  "suites": [
    {
      "id": "frozen",
      "status": "IMPLEMENTED",
      "depends_on": [],
      "components": [
        {
          "id": "frozen.manifest",
          "entrypoint": "check_frozen_files"
        }
      ],
      "owner_phase": "01",
      "description": "Verify frozen-files-SHA256SUMS byte integrity for protected inputs and archives."
    },
    {
      "id": "environment",
      "status": "IMPLEMENTED",
      "depends_on": [],
      "components": [
        {
          "id": "environment.doctor",
          "entrypoint": "check_environment"
        }
      ],
      "owner_phase": "01",
      "description": "Verify fixed CPython, repo venv or container interpreter, lock, direct deps, pip check, and profile capabilities."
    },
    {
      "id": "baseline",
      "status": "IMPLEMENTED",
      "depends_on": ["environment"],
      "components": [
        {
          "id": "baseline.reproduction",
          "entrypoint": "check_baseline"
        }
      ],
      "owner_phase": "02",
      "description": "Reproduce the manifest-bound v0.1-v0.3 baseline with 33 fail-closed cases (Phase 02)."
    },
    {
      "id": "traceability",
      "status": "IMPLEMENTED",
      "depends_on": ["environment"],
      "components": [
        {
          "id": "traceability.contract-audit",
          "entrypoint": "check_traceability"
        }
      ],
      "owner_phase": "03",
      "description": "Validate the requirements schema and cross-record semantics, D-group TTL bidirectional coverage, source smoke audit, and accepted blocking ADRs (Phase 03)."
    },
    {
      "id": "v0.4-model",
      "status": "IMPLEMENTED",
      "depends_on": ["environment", "traceability"],
      "components": [
        {
          "id": "v0.4-model.release-contract",
          "entrypoint": "check_v04_model"
        }
