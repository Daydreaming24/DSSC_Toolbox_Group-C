      "components": [
        {
          "id": "all.composition",
          "entrypoint": "check_all_composition"
        },
        {
          "id": "all.semantic-sparql",
          "entrypoint": "check_semantic_sparql"
        },
        {
          "id": "all.quality",
          "entrypoint": "check_quality_metrics"
        },
        {
          "id": "all.governance",
          "entrypoint": "check_governance"
        },
        {
          "id": "all.documentation",
          "entrypoint": "check_documentation"
        }
