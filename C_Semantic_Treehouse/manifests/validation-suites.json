      "owner_phase": "04",
      "description": "Validate the v0.4 release schema and cross-record manifest semantics, artifact hashes and provenance, requirements implementation coverage, inherited record contract, offline JSON-LD, and contract smoke (Phase 04)."
    },
    {
      "id": "v0.4",
      "status": "IMPLEMENTED",
      "depends_on": ["environment", "v0.4-model"],
      "components": [
        {
          "id": "v0.4.test-case-schema",
          "entrypoint": "check_v04_test_case_schema"
