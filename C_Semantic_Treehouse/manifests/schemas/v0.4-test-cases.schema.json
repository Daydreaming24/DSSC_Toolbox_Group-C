{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dssc.local/schemas/v0.4-test-cases.schema.json",
  "title": "DSSC v0.4 four-state test cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifest_schema_version",
    "suite",
    "release",
    "profile",
    "shape_artifact",
    "engine",
    "evidence_refs",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/v0.4-test-cases.schema.json"
    },
    "manifest_schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "suite": {
      "const": "v0.4"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"const": "v0.4"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"const": "dssc-building-energy-metadata-v0.4"}
      }
    },
    "shape_artifact": {
      "$ref": "#/$defs/shapeArtifact"
    },
    "engine": {
      "$ref": "#/$defs/engine"
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidenceRefs"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/passCase"},
          {"$ref": "#/$defs/failCase"},
          {"$ref": "#/$defs/inapplicableCase"},
          {"$ref": "#/$defs/untestableCase"}
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*//)(?!.*/$)[^\\u0000]+$"
    },
    "fixturePath": {
      "allOf": [
        {"$ref": "#/$defs/repoPath"},
        {
          "pattern": "^C_Semantic_Treehouse/fixtures/v0\\.4/(?:pass|fail|inapplicable|untestable)/.+$"
        }
      ]
    },
    "rdfIdentifier": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^D04-R[0-9]{3}$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^ADR-[0-9]{3}$"
    },
    "shapeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "artifact_id", "path", "sha256"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/id"},
        "artifact_id": {"const": "v04-metadata-shapes"},
        "path": {
          "const": "C_Semantic_Treehouse/model/v0.4/data-product-metadata-shapes.ttl"
        },
        "sha256": {
          "const": "a556039c0ec3030a9c4273c62a787e448b8869f7648e948663e10d3fe007cbda"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "inference",
        "advanced",
        "abort_on_first",
        "meta_shacl",
        "allow_warnings",
        "allow_infos",
        "do_owl_imports"
      ],
      "properties": {
        "name": {"const": "pySHACL"},
        "version": {"const": "0.40.1"},
        "inference": {"const": "none"},
        "advanced": {"const": true},
        "abort_on_first": {"const": false},
        "meta_shacl": {"const": true},
        "allow_warnings": {"const": false},
        "allow_infos": {"const": false},
        "do_owl_imports": {"const": false}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "kind", "path", "sha256"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["META_SHACL", "SHAPE_STRUCTURE"]},
        "path": {"$ref": "#/$defs/repoPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta_shacl", "shape_structure"],
      "properties": {
        "meta_shacl": {
          "allOf": [
            {"$ref": "#/$defs/evidenceRef"},
            {
              "type": "object",
              "properties": {"kind": {"const": "META_SHACL"}}
            }
          ]
        },
        "shape_structure": {
          "allOf": [
            {"$ref": "#/$defs/evidenceRef"},
            {
              "type": "object",
              "properties": {"kind": {"const": "SHAPE_STRUCTURE"}}
            }
          ]
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assertion_id", "path", "format", "sha256"],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/fixturePath"},
        "format": {"enum": ["json-ld", "turtle"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "baseCase": {
      "type": "object",
      "required": [
        "case_id",
        "fixture",
        "release_id",
        "profile_id",
        "shape_artifact_assertion_id",
        "requirement_ids",
        "decision_ids",
        "expected_business_status",
        "oracle"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "fixture": {"$ref": "#/$defs/fixture"},
        "release_id": {"const": "v0.4"},
        "profile_id": {"const": "dssc-building-energy-metadata-v0.4"},
        "shape_artifact_assertion_id": {"$ref": "#/$defs/id"},
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/requirementId"},
          "uniqueItems": true
        },
        "decision_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/decisionId"},
          "uniqueItems": true
        },
        "expected_business_status": {
          "enum": ["PASS", "FAIL", "INAPPLICABLE", "UNTESTABLE"]
        }
      }
    },
    "zeroResultCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact"],
      "properties": {
        "exact": {"const": 0}
      }
    },
    "positiveCountOracle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact"],
          "properties": {
            "exact": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "maximum": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "messageAssertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "value"],
          "properties": {
            "policy": {"const": "EXACT"},
            "value": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": {"const": "PRESENT"}
          }
        }
      ]
    },
    "iriTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_type", "value"],
      "properties": {
        "term_type": {"const": "IRI"},
        "value": {"$ref": "#/$defs/rdfIdentifier"}
      }
    },
    "literalTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_type", "lexical_form"],
      "properties": {
        "term_type": {"const": "LITERAL"},
        "lexical_form": {"type": "string"},
        "datatype": {"$ref": "#/$defs/rdfIdentifier"},
        "language": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "not": {
            "required": ["datatype", "language"]
          }
        }
      ]
    },
    "blankNodeTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_type", "match"],
      "properties": {
        "term_type": {"const": "BNODE"},
        "match": {"const": "ANY"}
      }
    },
    "rdfTermAssertion": {
      "oneOf": [
        {"$ref": "#/$defs/iriTerm"},
        {"$ref": "#/$defs/literalTerm"},
        {"$ref": "#/$defs/blankNodeTerm"}
      ]
    },
    "expectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "requirement_id",
        "source_shape",
        "source_constraint_component",
        "severity",
        "message",
        "count"
      ],
      "properties": {
        "assertion_id": {"$ref": "#/$defs/id"},
        "requirement_id": {"$ref": "#/$defs/requirementId"},
        "source_shape": {"$ref": "#/$defs/rdfIdentifier"},
        "source_constraint_component": {
          "type": "string",
          "pattern": "^sh:[A-Za-z]+ConstraintComponent$"
        },
        "result_path": {"$ref": "#/$defs/rdfIdentifier"},
        "severity": {"enum": ["sh:Violation", "sh:Warning"]},
        "message": {"$ref": "#/$defs/messageAssertion"},
        "count": {"$ref": "#/$defs/positiveCountOracle"},
        "focus_node": {"$ref": "#/$defs/rdfTermAssertion"},
        "value": {"$ref": "#/$defs/rdfTermAssertion"}
      }
    },
    "inapplicableExpectedResult": {
      "allOf": [
        {"$ref": "#/$defs/expectedResult"},
        {
          "type": "object",
          "properties": {
            "requirement_id": {"const": "D04-R016"},
            "source_shape": {"const": "ex:DatasetClosedShape"},
            "source_constraint_component": {
              "const": "sh:ClosedConstraintComponent"
            },
            "severity": {"const": "sh:Warning"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "passOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_target_activation_minimum", "result_count"],
      "properties": {
        "expected_target_activation_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "result_count": {"$ref": "#/$defs/zeroResultCount"}
      }
    },
    "failOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_target_activation_minimum",
        "result_count",
        "expected_results"
      ],
      "properties": {
        "expected_target_activation_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "result_count": {"$ref": "#/$defs/positiveCountOracle"},
        "expected_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/expectedResult"},
          "contains": {
            "type": "object",
            "properties": {"severity": {"const": "sh:Violation"}},
            "required": ["severity"]
          },
          "minContains": 1
        }
      }
    },
    "inapplicableOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_target_activation_minimum",
        "result_count",
        "expected_results"
      ],
      "properties": {
        "expected_target_activation_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "result_count": {"$ref": "#/$defs/positiveCountOracle"},
        "expected_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inapplicableExpectedResult"}
        }
      }
    },
    "untestableOracle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure_stage", "reason_code"],
          "properties": {
            "failure_stage": {"const": "INPUT_PARSE"},
            "reason_code": {"enum": ["MALFORMED_JSON", "MALFORMED_RDF"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure_stage", "reason_code"],
          "properties": {
            "failure_stage": {"const": "OFFLINE_LOAD"},
            "reason_code": {
              "enum": ["JSONLD_EXPANSION_ERROR", "OFFLINE_CONTEXT_UNAVAILABLE"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["failure_stage", "reason_code"],
          "properties": {
            "failure_stage": {"const": "VALIDATOR_EXECUTION"},
            "reason_code": {
              "enum": [
                "VALIDATOR_TIMEOUT",
                "VALIDATOR_CRASH",
                "VALIDATION_SERVICE_RUNTIME_EXCEPTION"
              ]
            }
          }
        }
      ]
    },
    "passCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "expected_business_status": {"const": "PASS"},
            "oracle": {"$ref": "#/$defs/passOracle"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "failCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "expected_business_status": {"const": "FAIL"},
            "oracle": {"$ref": "#/$defs/failOracle"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "inapplicableCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "expected_business_status": {"const": "INAPPLICABLE"},
            "oracle": {"$ref": "#/$defs/inapplicableOracle"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "untestableCase": {
      "allOf": [
        {"$ref": "#/$defs/baseCase"},
        {
          "type": "object",
          "properties": {
            "expected_business_status": {"const": "UNTESTABLE"},
            "oracle": {"$ref": "#/$defs/untestableOracle"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
