{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dssc.local/schemas/validation-suites.schema.json",
  "title": "DSSC validation-suites registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_version", "suites"],
  "properties": {
    "$schema": {
      "const": "schemas/validation-suites.schema.json"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Sole top-level contract version field. Bump on any suite status, dependency, or composition change."
    },
    "suites": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/suite"
      }
    }
  },
  "$defs": {
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "depends_on",
        "components",
        "owner_phase",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "frozen",
            "environment",
            "baseline",
            "traceability",
            "v0.4-model",
            "v0.4",
            "all"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["IMPLEMENTED", "NOT_IMPLEMENTED"]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "frozen",
              "environment",
              "baseline",
              "traceability",
              "v0.4-model",
              "v0.4",
              "all"
            ]
          },
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "owner_phase": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "IMPLEMENTED"}},
            "required": ["status"]
          },
          "then": {"properties": {"components": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {"status": {"const": "NOT_IMPLEMENTED"}},
            "required": ["status"]
          },
          "then": {"properties": {"components": {"maxItems": 0}}}
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entrypoint"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1,
          "description": "Logical entrypoint ID from the controlled catalog (not a shell command)."
        }
      }
    }
  }
}
